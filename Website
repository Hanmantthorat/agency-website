            const loading = document.getElementById('audit-loading-container');
            const results = document.getElementById('audit-results-container');
            const bar = document.getElementById('audit-progress-bar');
            const status = document.getElementById('audit-status-text');

            form.classList.add('hidden');
            loading.classList.remove('hidden');

            let progress = 0;
            const interval = setInterval(() => {
                progress += 20;
                bar.style.width = `${progress}%`;
                if (progress === 40) status.innerText = 'Evaluating SEO Metadata & Headings...';
                if (progress === 80) status.innerText = 'Calculating Mobile PageSpeed Score...';
                
                if (progress >= 100) {
                    clearInterval(interval);
                    loading.classList.add('hidden');
                    results.classList.remove('hidden');
                    document.getElementById('audit-res-url').innerText = `${url} Report`;
                }
            }, 400);
