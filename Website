        .gradient-text {
            background: linear-gradient(135deg, #38BDF8 0%, #6366F1 50%, #EC4899 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gradient-border {
            position: relative;
            background: rgba(19, 25, 39, 0.8);
            backdrop-filter: blur(12px);
        }
        .gradient-border::before {
            content: '';
            position: absolute;
            inset: -1px;
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(99, 102, 241, 0.1), rgba(236, 72, 153, 0.3));
            border-radius: inherit;
            z-index: -1;
            transition: opacity 0.3s ease;
        }
        .glass-card {
            background: rgba(19, 25, 39, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card:hover {
